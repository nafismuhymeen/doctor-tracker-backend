NODE_ENV=development
PORT=5000

CLIENT_URLS=http://localhost:3000

MONGODB_URI=

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

COOKIE_SAME_SITE=lax
# Reverse proxy hops: 1 for direct Render/load balancer, 2 when proxied through Vercel Next.js rewrite
TRUST_PROXY=1

AUTH_RATE_LIMIT_MAX=10
GENERAL_RATE_LIMIT_MAX=300

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10

MIN_BOOKING_LEAD_MINUTES=15
VISIT_EDIT_WINDOW_HOURS=24
AUDIT_RETENTION_DAYS=

ENABLE_DOCS=true
ALLOW_SEED_RESET=false
ALLOW_DEMO_SEED=false

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=

STAFF_EMAIL=
STAFF_PASSWORD=

DOCTOR_USER_EMAIL=
DOCTOR_USER_PASSWORD=

VIEWER_EMAIL=
VIEWER_PASSWORD=
