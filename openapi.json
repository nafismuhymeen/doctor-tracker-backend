          "patientId": {
            "type": "string"
          },
          "appointmentId": {
            "type": "string"
          },
          "visitDate": {
            "type": "string",
            "format": "date-time"
          },
          "chiefComplaint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "diagnosis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "vitals": {
            "type": "object",
            "properties": {
              "bpSystolic": {
                "type": "number",
