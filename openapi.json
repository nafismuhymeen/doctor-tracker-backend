                "drug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "dose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "frequency": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "durationDays": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                }
              },
              "required": [
                "drug",
                "dose",
                "frequency",
                "durationDays"
              ],
              "additionalProperties": false
            }
          },
          "followUpDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "patientId",
          "chiefComplaint",
          "diagnosis",
          "notes"
        ],
        "additionalProperties": false
      },
