  "security": [
    {
      "cookieAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness probe",
        "security": [],
        "responses": {
          "200": {
            "description": "API is healthy and running"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness probe",
        "security": [],
        "responses": {
          "200": {
            "description": "API and Database connection are ready to serve traffic"
          },
          "503": {
            "description": "Database is not connected or ping failed"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticate user and issue session cookies",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful; sets accessToken and refreshToken cookies"
          },
          "401": {
            "description": "Invalid email or password"
          },
          "403": {
            "description": "User account disabled"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Rotate refresh token and issue new token pair",
        "security": [],
        "responses": {
          "200": {
            "description": "Tokens refreshed successfully"
          },
          "401": {
            "description": "Session revoked, expired, or reuse detected"
          },
          "409": {
            "description": "Multi-tab rotation grace window race"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get current authenticated user profile",
        "responses": {
          "200": {
            "description": "User profile retrieved"
          },
          "401": {
