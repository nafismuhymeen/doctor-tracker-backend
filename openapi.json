              },
              "temperatureC": {
                "type": "number",
                "minimum": 30,
                "maximum": 45
              },
              "weightKg": {
                "type": "number",
                "minimum": 1,
                "maximum": 300
              }
            },
            "additionalProperties": false
          },
          "prescriptions": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
