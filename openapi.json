{
  "openapi": "3.1.0",
  "info": {
    "title": "Doctor Tracker API",
    "version": "1.0.0",
    "description": "Production-ready Express 5 + Mongoose + Zod modular monolith API for hospital doctor, patient, appointment, and clinical visit lifecycle management."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "v1 API base path"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "JWT Access Token sent via httpOnly, secure, sameSite cookie."
      }
    },
    "schemas": {
      "StandardSuccess": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "success"
        ]
      },
      "StandardError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "FORBIDDEN"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "ChangePasswordInput": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 72,
            "allOf": [
              {
                "pattern": "[A-Za-z]"
              },
              {
                "pattern": "\\d"
              }
            ]
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "additionalProperties": false
      },
      "CreateUserInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 72,
            "allOf": [
              {
                "pattern": "[A-Za-z]"
              },
              {
                "pattern": "\\d"
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "staff",
              "doctor",
              "viewer"
            ]
          },
          "doctorId": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "role"
        ],
        "additionalProperties": false
      },
      "UpdateUserInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "staff",
              "doctor",
              "viewer"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "doctorId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "ResetUserPasswordInput": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 72,
            "allOf": [
              {
                "pattern": "[A-Za-z]"
              },
              {
                "pattern": "\\d"
              }
            ]
          }
        },
        "required": [
          "password"
        ],
        "additionalProperties": false
      },
      "UserQueryInput": {
        "type": "object",
        "properties": {
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "staff",
              "doctor",
              "viewer"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "search": {
            "type": "string"
          }
        },
        "required": [
          "page",
          "limit"
        ],
        "additionalProperties": false
      },
      "CreateDoctorInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "specialization": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "hospital": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150
          },
          "phone": {
            "type": "string",
            "minLength": 7,
            "maxLength": 20
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "timezone": {
            "default": "Asia/Dhaka",
            "type": "string"
          },
          "slotMinutes": {
            "default": 30,
            "type": "integer",
            "minimum": 10,
            "maximum": 120
          },
          "workingHours": {
            "maxItems": 28,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dayOfWeek": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "start": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                }
              },
              "required": [
                "dayOfWeek",
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "specialization",
          "hospital",
          "phone",
          "email",
          "timezone",
          "slotMinutes"
        ],
        "additionalProperties": false
      },
      "UpdateDoctorInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "specialization": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "hospital": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150
          },
          "phone": {
            "type": "string",
            "minLength": 7,
            "maxLength": 20
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "timezone": {
            "type": "string"
          },
          "slotMinutes": {
            "type": "integer",
            "minimum": 10,
            "maximum": 120
          },
          "workingHours": {
            "maxItems": 28,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dayOfWeek": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "start": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                }
              },
              "required": [
                "dayOfWeek",
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "DoctorQueryInput": {
        "type": "object",
        "properties": {
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "search": {
            "type": "string",
            "maxLength": 100
          },
          "specialization": {
            "type": "string"
          },
          "hospital": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "page",
          "limit"
        ],
        "additionalProperties": false
      },
      "DeleteDoctorQueryInput": {
        "type": "object",
        "properties": {
          "reassignToDoctorId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreatePatientInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "age": {
            "type": "integer",
            "minimum": 0,
            "maximum": 130
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "other"
            ]
          },
          "phone": {
            "type": "string",
            "minLength": 7,
            "maxLength": 20
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          },
          "condition": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150
          }
        },
        "required": [
          "name",
          "age",
          "gender",
          "phone",
          "condition"
        ],
        "additionalProperties": false
      },
      "UpdatePatientInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "age": {
            "type": "integer",
            "minimum": 0,
            "maximum": 130
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "other"
            ]
          },
          "phone": {
            "type": "string",
            "minLength": 7,
            "maxLength": 20
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          },
          "condition": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150
          }
        },
        "additionalProperties": false
      },
      "PatientQueryInput": {
        "type": "object",
        "properties": {
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "search": {
            "type": "string",
            "maxLength": 100
          },
          "condition": {
            "type": "string"
          },
          "doctorId": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "page",
          "limit"
        ],
        "additionalProperties": false
      },
      "CreateAppointmentInput": {
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "string"
          },
          "patientId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "doctorId",
          "patientId",
          "startsAt"
        ],
        "additionalProperties": false
      },
      "UpdateAppointmentStatusInput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "cancelled",
              "no_show"
            ]
          },
          "cancelReason": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "RescheduleAppointmentInput": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "startsAt"
        ],
        "additionalProperties": false
      },
      "AppointmentQueryInput": {
        "type": "object",
        "properties": {
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "doctorId": {
            "type": "string"
          },
          "patientId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "completed",
              "cancelled",
              "no_show"
            ]
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "page",
          "limit"
        ],
        "additionalProperties": false
      },
      "CreateVisitInput": {
